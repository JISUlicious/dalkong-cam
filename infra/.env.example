# infra/.env — Compose-level configuration for the self-hosted stack.
#
# This file is read automatically by `docker compose` for ${VAR} interpolation
# inside docker-compose.yml. Do NOT commit the real .env (already gitignored).
#
# Some values are duplicated in apps/api/.env because they are needed both at
# the infra layer (Compose, Caddy, coturn CLI flags) and inside the api app.
# Where duplicated, the values MUST match exactly. The duplicates are flagged
# with [SYNCED] below.

# ── Hostname & TLS ──────────────────────────────────────────────────────────
# The single subdomain that fronts the API, MinIO, and coturn.
# Examples: cam.example.com, dalkong.example.com
DOMAIN=cam.example.com

# Email used by Caddy when registering with Let's Encrypt for cert issuance
# and renewal warnings. Should be a real address you read.
ADMIN_EMAIL=admin@example.com

# If your VPS is behind NAT and coturn's auto-detection picks the wrong
# address, uncomment the `external-ip=...` line in coturn/turnserver.conf
# instead of setting it here. Most single-NIC VPSes don't need it.

# ── Postgres ────────────────────────────────────────────────────────────────
# Strong password for the postgres user. Must match the password embedded in
# DATABASE_URL inside apps/api/.env.       [SYNCED with apps/api/.env]
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ── MinIO (S3-compatible object store) ──────────────────────────────────────
# These become the MinIO root credentials. The api app uses the same values
# to sign upload/download URLs.            [SYNCED with apps/api/.env]
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-32-byte-base64-secret

# ── coturn ──────────────────────────────────────────────────────────────────
# HMAC secret for ephemeral TURN credentials. The api signs creds with this
# secret; coturn verifies. Rotating this immediately invalidates every
# outstanding cred.                         [SYNCED with apps/api/.env]
TURN_SHARED_SECRET=replace-with-32-byte-base64-secret
