{
  "name": "@dalkong/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "npm run build --prefix ../../packages/shared",
    "dev": "npm run build:shared && tsx watch src/index.ts",
    "build": "npm run build:shared && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "npm run build:shared && tsc --noEmit",
    "test": "npm run build:shared && vitest run"
  },
  "dependencies": {
    "@dalkong/shared": "file:../../packages/shared",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.40.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "minio": "^8.0.1",
    "nodemailer": "^8.0.7",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.4",
    "zod": "^3.23.8",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.4.1",
    "@types/nodemailer": "^6.4.15",
    "@types/zxcvbn": "^4.4.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  }
}
