NODE_ENV=development
PORT=3001
PUBLIC_BASE_URL=https://your.domain

DATABASE_URL=postgres://dalkong:dalkong@localhost:5432/dalkong

JWT_ACCESS_SECRET=replace-me-with-32-bytes-base64
JWT_REFRESH_SECRET=replace-me-with-another-32-bytes-base64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

EMAIL_VERIFICATION_SECRET=replace-me-with-32-bytes-base64
EMAIL_FROM=no-reply@your.domain
SMTP_URL=smtp://user:pass@smtp.example.com:587

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dalkong
MINIO_SECRET_KEY=dalkong-secret-change-me
MINIO_BUCKET=dalkong-videos
MINIO_PUBLIC_BASE_URL=https://your.domain/media

TURN_REALM=your.domain
TURN_SHARED_SECRET=replace-me-with-32-bytes-base64
TURN_TTL_SECONDS=86400
TURN_URLS=turn:turn.your.domain:3478,turns:turn.your.domain:5349
STUN_URLS=stun:turn.your.domain:3478

FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=

CORS_ORIGINS=https://your.domain
