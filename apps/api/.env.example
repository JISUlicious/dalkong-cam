# apps/api/.env — Fastify API configuration.
#
# Some values are duplicated in infra/.env because they are needed both at
# the infra layer (Compose / Caddy / coturn) and inside the api app. Where
# duplicated, the values MUST match exactly. The duplicates are flagged
# with [SYNCED] below.

NODE_ENV=development
PORT=3001

# The public origin the mobile app uses to reach this API.
# Verification email links and Caddy issue certs for this hostname.
# Example: https://cam.example.com
PUBLIC_BASE_URL=https://cam.example.com

# ── Postgres ────────────────────────────────────────────────────────────────
# The password embedded here MUST match POSTGRES_PASSWORD in infra/.env.
#                                            [SYNCED with infra/.env]
DATABASE_URL=postgres://dalkong:replace-with-strong-postgres-password@postgres:5432/dalkong

# ── JWT (issued by us, no infra duplication) ────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-me-with-32-bytes-base64
JWT_REFRESH_SECRET=replace-me-with-another-32-bytes-base64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── Email verification ──────────────────────────────────────────────────────
EMAIL_VERIFICATION_SECRET=replace-me-with-32-bytes-base64

# Set to false to skip email verification entirely (signup auto-verifies the
# new user). Useful for self-only deployments or initial standup before SMTP
# is configured. SMTP_URL/EMAIL_FROM can be left empty in that case.
# Default (production posture): true.
EMAIL_VERIFICATION_REQUIRED=true

# Required when EMAIL_VERIFICATION_REQUIRED=true; ignored otherwise.
# Use your apex domain so users see a recognisable from-address.
EMAIL_FROM=no-reply@example.com
# Common SMTP_URL forms:
#   smtp://user:pass@smtp.example.com:587   (most providers)
#   smtps://user:pass@smtp.example.com:465  (TLS-wrapped)
#   smtp://mailpit:1025                     (local Mailpit, no auth — see infra/docker-compose.yml)
# Free tiers: Resend, Postmark, Mailgun, Brevo, Amazon SES; Gmail with
# an app-password also works for personal use.
SMTP_URL=smtp://user:pass@smtp.example.com:587

# ── MinIO (must match infra/.env) ───────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
#                                            [SYNCED with infra/.env]
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-32-byte-base64-secret
MINIO_BUCKET=dalkong-videos
# Optional: public base URL when serving objects through Caddy's /media path.
# Example: https://cam.example.com/media
MINIO_PUBLIC_BASE_URL=

# ── coturn (must match infra/.env) ──────────────────────────────────────────
TURN_REALM=cam.example.com
#                                            [SYNCED with infra/.env]
TURN_SHARED_SECRET=replace-with-32-byte-base64-secret
TURN_TTL_SECONDS=86400
# Same hostname as PUBLIC_BASE_URL — coturn shares the host but uses a
# different port. Drop the `turns:` entry if you skipped TURNS in v1.
TURN_URLS=turn:cam.example.com:3478,turns:cam.example.com:5349
STUN_URLS=stun:cam.example.com:3478

# ── Push (optional; leave blank to disable until configured) ────────────────
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=

# ── CORS ────────────────────────────────────────────────────────────────────
# Mobile-only deployments can leave this empty (RN's fetch ignores CORS).
# Set if you ever serve a web client.
CORS_ORIGINS=https://cam.example.com
